# Local (non-Docker) dev: copy to backend/.env and adjust as needed.
# python-decouple reads this file from the backend/ working directory.
SECRET_KEY=dev-secret-key-not-for-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Harare
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL unset to use a local SQLite file (db.sqlite3) — the
# quickest way to run the backend without Postgres/Docker installed.
# DATABASE_URL=postgres://mining:mining@localhost:5432/mining_production

# Leave REDIS_URL unset to run Celery in eager (synchronous, in-process)
# mode and cache in memory — no Redis server required for local dev.
# REDIS_URL=redis://localhost:6379/0

SEED_DEMO=false
