# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Harare
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=false

# --- Database (Postgres, used by docker-compose) ---
POSTGRES_DB=mining_production
POSTGRES_USER=mining
POSTGRES_PASSWORD=mining
# DATABASE_URL is set automatically by docker-compose from the values above.
# For running the backend outside Docker, set it explicitly, e.g.:
# DATABASE_URL=postgres://mining:mining@localhost:5432/mining_production

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Seed data ---
# Set to true to load demo master data (sites/sections/machines/parameters/
# users) on container startup. Leave false in real deployments.
SEED_DEMO=true

# --- Misc ---
FORM_SCHEMA_CACHE_SECONDS=300
SECURE_SSL_REDIRECT=false

# --- Dashboard (docker-compose only) ---
# Base URL the dashboard container's browser client uses to reach the API —
# this runs in the browser on your host machine, so it must be the
# host-reachable URL (http://localhost:8000/api), not a Docker service name.
DASHBOARD_API_BASE_URL=http://localhost:8000/api
